{
  "name": "@kitgenix/hoplane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hoplane by Kitgenix — a source-available, self-hosted URL shortener for Cloudflare with QR codes and privacy-first analytics.",
  "author": "Kitgenix (https://kitgenix.com)",
  "homepage": "https://kitgenix.com/hoplane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitgenix/hoplane.git"
  },
  "bugs": "https://github.com/Kitgenix/hoplane/issues",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "cloudflare": {
    "label": "Hoplane by Kitgenix",
    "products": [
      "Workers",
      "D1",
      "KV"
    ],
    "categories": [
      "storage"
    ],
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Required secret for creating the first owner account and for the documented owner-recovery process. Generate at least 32 random characters; save it securely. Never commit it to Git."
      },
      "DB": {
        "description": "D1 database for links, user accounts, settings, and analytics. Provision this in your own Cloudflare account."
      },
      "CACHE": {
        "description": "Cloudflare KV namespace for caching link lookups at the edge. Provision this in your own Cloudflare account."
      }
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
