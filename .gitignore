# Hoplane — files that must not be committed to Git.

# Dependencies and generated build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Cloudflare Wrangler local state (including local D1 and KV)
.wrangler/

# Local development secrets. Commit example templates only.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Local tooling and test artefacts
.cache/
.vite/
test-results/
playwright-report/
.npm/

# Logs and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Developer-specific AI assistant settings
.claude/settings.local.json

# Local environment tools
.envrc
.direnv/

# Local database files created outside Wrangler
*.sqlite
*.sqlite3
*.sqlite3-journal

# Private certificates and keys
*.pem
*.p12
*.pfx