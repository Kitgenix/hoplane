/**
 * Hoplane by Kitgenix — Cloudflare Workers configuration.
 * https://kitgenix.com
 * https://github.com/Kitgenix/hoplane
 *
 * This file is a reusable deployment template. Do not commit account-specific
 * resource IDs or secrets to the upstream repository.
 *
 * Wrangler supports automatic provisioning of D1 and KV bindings without
 * IDs. A local CLI deployment may write provisioned IDs into this file;
 * Git-connected deployments may instead retain them only in Cloudflare.
 * Confirm the actual bindings after the first deployment.
 *
 * For account-specific pinned IDs, use `npm run setup` in your own copy.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoplane",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },

  // Requests pass through the Worker unless they are built static assets.
  // Preserve this routing for short links, the API, and dashboard auth.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"]
  },

  // Application data: links, accounts, permissions, and click analytics.
  // Runtime schema migration logic must be tested before production upgrades.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoplane",
      "migrations_dir": "migrations"
    }
  ],

  // Eventual-consistency edge cache for link lookups.
  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],

  // Daily housekeeping: retention, sessions, visitor salt, optional R2 backup.
  // Cloudflare cron expressions are evaluated in UTC (03:17 UTC daily).
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  // Non-sensitive deployment settings; these are source-controlled.
  // Keep SETUP_TOKEN in Worker secrets, never in vars.
  "vars": {
    "SITE_NAME": "Hoplane",
    "HOME_URL": "",
    "SLUG_LENGTH": "6",
    "CASE_SENSITIVE": "false",
    "RETENTION_DAYS": "365"
  }

  // Optional link-only nightly backups. Enable R2 in your Cloudflare account,
  // uncomment this binding, and verify the bucket exists after deployment.
  // "r2_buckets": [
  //   { "binding": "BACKUPS", "bucket_name": "hoplane-backups" }
  // ]
}
