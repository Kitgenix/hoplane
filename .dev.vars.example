# Hoplane — LOCAL development secrets example.
# Copy this file to .dev.vars and replace the placeholder before starting locally.
# Wrangler reads .dev.vars during local development; it does not set production secrets.
#
# Generate a random token with: openssl rand -base64 32
# Store your actual production SETUP_TOKEN securely as a Cloudflare Worker secret:
#   npx wrangler secret put SETUP_TOKEN
#
# SETUP_TOKEN is required for initial owner setup and may be needed for owner recovery.
# Do not commit .dev.vars, production tokens, or real credentials.
SETUP_TOKEN=replace-with-a-long-random-token
